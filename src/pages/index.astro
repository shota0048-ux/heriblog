---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostGrid from '../components/PostGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { SERIES } from '../data/series';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const byId = new Map(allPosts.map((p) => [p.id, p]));
const pick = (ids) => ids.map((id) => byId.get(id)).filter(Boolean);

// 注目記事（ピックアップ）— 編集可。存在しないIDは自動で除外されます
const featured = pick([
	'helicopter-firefighting-2026',
	'ah23-vs-r22-2026',
	'voices-voluntary-safety-report-2026',
]);

// 連載・シリーズ — 定義は src/data/series.ts（特集ハブ /blog/series/ と共用）
const series = SERIES.map((s) => ({ slug: s.slug, title: s.title, posts: pick(s.ids) })).filter(
	(s) => s.posts.length > 0,
);

const latest = allPosts.slice(0, 6);

// カテゴリ（件数つき・記事の多い順）
const counts = {};
for (const p of allPosts) {
	const c = p.data.category;
	if (c) counts[c] = (counts[c] || 0) + 1;
}
const categories = Object.entries(counts)
	.sort((a, b) => b[1] - a[1])
	.map(([name, count]) => ({ name, count }));
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
				color: #fff;
				padding: 4rem 1.5rem 5rem;
				text-align: center;
				position: relative;
				overflow: hidden;
			}
			.hero::before {
				content: "";
				position: absolute;
				inset: 0;
				background-image:
					radial-gradient(circle at 20% 80%, rgba(182, 90, 59, 0.15), transparent 50%),
					radial-gradient(circle at 80% 20%, rgba(216, 130, 94, 0.1), transparent 50%);
				pointer-events: none;
			}
			.hero-inner {
				max-width: 720px;
				margin: 0 auto;
				position: relative;
			}
			.hero h1 {
				font-family: var(--font-serif);
				color: #fff;
				font-size: 2.6rem;
				margin: 0 0 0.4em;
				letter-spacing: 0.05em;
			}
			.hero-mark {
				color: var(--color-accent-soft);
				display: inline-block;
				transform: rotate(-15deg);
				margin-right: 0.2em;
			}
			.hero p {
				color: rgba(255, 255, 255, 0.85);
				font-size: 1.05rem;
				line-height: 1.9;
				max-width: 540px;
				margin: 0 auto 1.5em;
			}
			.hero-actions {
				display: flex;
				gap: 0.7rem;
				justify-content: center;
				flex-wrap: wrap;
			}
			.hero-btn {
				display: inline-block;
				padding: 0.6em 1.4em;
				border-radius: 999px;
				text-decoration: none;
				font-size: 0.92rem;
				font-weight: 600;
				transition: transform 0.15s ease, background 0.15s ease;
			}
			.hero-btn.primary {
				background: var(--color-accent);
				color: #fff;
			}
			.hero-btn.ghost {
				background: rgba(255, 255, 255, 0.12);
				color: #fff;
				border: 1px solid rgba(255, 255, 255, 0.35);
			}
			.hero-btn:hover {
				transform: translateY(-2px);
			}

			main {
				max-width: 1080px;
				margin: 0 auto;
				padding: 3rem 1.5rem 2rem;
			}
			.block {
				margin-bottom: 3.5rem;
			}
			.section-title {
				font-family: var(--font-serif);
				font-size: 1.4rem;
				color: var(--color-primary);
				margin: 0 0 0.3em;
				display: flex;
				align-items: baseline;
				gap: 0.6em;
			}
			.section-title::after {
				content: "";
				flex: 1;
				height: 1px;
				background: var(--color-border);
			}
			.section-sub {
				color: var(--color-text-muted);
				font-size: 0.9rem;
				margin: 0 0 1.6rem;
			}

			/* カテゴリ（件数つき） */
			.categories {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.category-tag {
				background: var(--color-surface);
				border: 1px solid var(--color-border);
				border-radius: 999px;
				padding: 0.4rem 0.95rem;
				font-size: 0.85rem;
				color: var(--color-text-soft);
				font-weight: 500;
				text-decoration: none;
				transition: border-color 0.15s, color 0.15s;
			}
			.category-tag:hover {
				border-color: var(--color-accent);
				color: var(--color-accent);
			}
			.cat-count {
				color: var(--color-text-muted);
				font-size: 0.78em;
				margin-left: 0.35em;
			}

			/* 連載・シリーズ */
			.series-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
				gap: 1.4rem;
			}
			.series-card {
				background: var(--color-surface);
				border: 1px solid var(--color-border);
				border-radius: 12px;
				padding: 1.3rem 1.4rem 1.4rem;
				border-top: 3px solid var(--color-accent);
			}
			.series-title {
				font-family: var(--font-serif);
				font-size: 1.08rem;
				color: var(--color-primary);
				margin: 0 0 0.8rem;
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 0.5em;
			}
			.series-title a {
				color: inherit;
				text-decoration: none;
			}
			.series-title a:hover {
				color: var(--color-accent);
			}
			.series-see-all {
				text-align: center;
				margin-top: 1.6rem;
			}
			.series-see-all a {
				color: var(--color-accent);
				text-decoration: none;
				font-size: 0.9rem;
			}
			.series-see-all a:hover {
				text-decoration: underline;
			}
			.series-count {
				font-size: 0.72rem;
				font-weight: 600;
				color: var(--color-accent);
				background: rgba(182, 90, 59, 0.08);
				padding: 0.15rem 0.5rem;
				border-radius: 999px;
				white-space: nowrap;
			}
			.series-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.series-list li {
				border-top: 1px dashed var(--color-border);
			}
			.series-list li:first-child {
				border-top: none;
			}
			.series-list a {
				display: block;
				padding: 0.55rem 0;
				font-size: 0.9rem;
				line-height: 1.5;
				color: var(--color-text-soft);
				text-decoration: none;
				transition: color 0.15s;
			}
			.series-list a::before {
				content: "›";
				color: var(--color-accent);
				margin-right: 0.5em;
			}
			.series-list a:hover {
				color: var(--color-accent);
			}

			.see-all {
				text-align: center;
				margin: 1rem 0;
			}
			.see-all-link {
				display: inline-block;
				padding: 0.7em 1.8em;
				background: var(--color-primary);
				color: #fff;
				text-decoration: none;
				border-radius: 999px;
				font-size: 0.95rem;
				font-weight: 500;
				transition: background 0.2s;
			}
			.see-all-link:hover {
				background: var(--color-accent);
				color: #fff;
			}

			@media (max-width: 720px) {
				.hero {
					padding: 2.2rem 1rem 2.5rem;
				}
				.hero h1 {
					font-size: 1.8rem;
				}
				.hero p {
					font-size: 0.9rem;
					line-height: 1.7;
				}
				main {
					padding: 1.8rem 1rem 1rem;
				}
				.block {
					margin-bottom: 2.5rem;
				}
				.section-title {
					font-size: 1.2rem;
				}
				.series-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<section class="hero">
			<div class="hero-inner">
				<h1><span class="hero-mark">✈</span>ヘリブログ</h1>
				<p>現役ヘリコプターパイロットが書く航空ブログ。<br />飛行の現場から、機体のこと、事故の教訓、訓練のことまで。</p>
				<div class="hero-actions">
					<a href="/blog" class="hero-btn primary">記事を読む</a>
					<a href="/search" class="hero-btn ghost">🔍 検索</a>
				</div>
			</div>
		</section>
		<main>
			<section class="block">
				<h2 class="section-title">最新の記事</h2>
				<p class="section-sub">直近の更新</p>
				<PostGrid posts={latest} />
			</section>

			{featured.length > 0 && (
				<section class="block">
					<h2 class="section-title">ピックアップ</h2>
					<p class="section-sub">まず読んでほしい記事</p>
					<PostGrid posts={featured} />
				</section>
			)}

			{series.length > 0 && (
				<section class="block">
					<h2 class="section-title">連載・シリーズ</h2>
					<p class="section-sub">続報や関連テーマをまとめて</p>
					<div class="series-grid">
						{series.map((s) => (
							<div class="series-card">
								<h3 class="series-title">
									<a href={`/blog/series/${s.slug}/`}>{s.title}</a>
									<span class="series-count">{s.posts.length}記事</span>
								</h3>
								<ul class="series-list">
									{s.posts.map((p) => (
										<li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>
									))}
								</ul>
							</div>
						))}
					</div>
					<p class="series-see-all"><a href="/blog/series/">すべての特集を見る →</a></p>
				</section>
			)}

			<section class="block">
				<h2 class="section-title">カテゴリ</h2>
				<p class="section-sub">関心のあるテーマからどうぞ</p>
				<div class="categories">
					{categories.map((cat) => (
						<a href={`/blog/category/${cat.name}/`} class="category-tag">
							{cat.name}<span class="cat-count">{cat.count}</span>
						</a>
					))}
				</div>
			</section>

			<div class="see-all">
				<a href="/blog" class="see-all-link">すべての記事を見る →</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
