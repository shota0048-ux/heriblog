---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PostGrid from '../../../components/PostGrid.astro';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const all = await getCollection('blog');
	const counts = {};
	for (const p of all) {
		for (const t of p.data.tags ?? []) counts[t] = (counts[t] || 0) + 1;
	}
	const tags = Object.entries(counts)
		.sort((a, b) => b[1] - a[1])
		.map(([name]) => name);
	return tags.map((tag) => ({ params: { tag }, props: { tag, tags } }));
}

const { tag, tags } = Astro.props;
const posts = (await getCollection('blog'))
	.filter((post) => (post.data.tags ?? []).includes(tag))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`#${tag} の記事 | ${SITE_TITLE}`} description={`「${tag}」タグの記事一覧。`} />
		<style>
			main {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto;
				padding: 3rem 1.5rem;
			}
			.page-title {
				font-family: var(--font-serif);
				font-size: 2rem;
				margin: 0 0 0.3em;
				color: var(--color-primary);
				text-align: center;
			}
			.page-sub {
				color: var(--color-text-muted);
				text-align: center;
				margin-bottom: 2rem;
				font-size: 0.95rem;
			}
			.tag-nav {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
				justify-content: center;
				margin-bottom: 2.5rem;
			}
			.tag-nav a {
				background: var(--color-surface);
				border: 1px solid var(--color-border);
				border-radius: 999px;
				padding: 0.4rem 0.95rem;
				font-size: 0.85rem;
				color: var(--color-text-soft);
				font-weight: 500;
				text-decoration: none;
				transition: all 0.15s;
			}
			.tag-nav a:hover {
				border-color: var(--color-accent);
				color: var(--color-accent);
			}
			.tag-nav a.active {
				background: var(--color-primary);
				color: #fff;
				border-color: var(--color-primary);
			}
			@media (max-width: 720px) {
				main {
					padding: 1.8rem 1rem;
				}
				.page-title {
					font-size: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">#{tag}</h1>
			<p class="page-sub">{posts.length} 件の記事</p>

			<nav class="tag-nav">
				{tags.map((t) => (
					<a href={`/blog/tag/${t}/`} class={t === tag ? 'active' : ''}>#{t}</a>
				))}
			</nav>

			<PostGrid posts={posts} />
		</main>
		<Footer />
	</body>
</html>
