---
// 存在しないアドレス用のページ。
// これが無いと Cloudflare Pages はトップページを「200（正常）」で返してしまい、
// /wp-login.php などを試す脆弱性診断ツールが「PHP が公開されている」と誤検知したり、
// Google にソフト 404 と判断されたりする。dist/404.html があると 404 で返る。
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`ページが見つかりません | ${SITE_TITLE}`} description="お探しのページは見つかりませんでした。" />
		<meta name="robots" content="noindex" />
		<style>
			main {
				max-width: 760px;
				margin: 0 auto;
				padding: 4rem 1.5rem 5rem;
				text-align: center;
			}
			.code {
				font-family: var(--font-serif);
				font-size: 3.5rem;
				color: var(--color-primary);
				margin: 0;
				line-height: 1;
			}
			h1 {
				font-family: var(--font-serif);
				font-size: 1.5rem;
				margin: 0.6em 0 0.4em;
				color: var(--color-primary);
			}
			p {
				color: var(--color-text-muted);
				margin: 0.4em 0;
			}
			.links {
				margin-top: 2rem;
				display: flex;
				gap: 0.8rem;
				justify-content: center;
				flex-wrap: wrap;
			}
			.links a {
				display: inline-block;
				padding: 0.55em 1.2em;
				border-radius: 999px;
				border: 1px solid var(--color-border);
				text-decoration: none;
			}
			.links a:hover {
				border-color: var(--color-accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="code">404</p>
			<h1>ページが見つかりませんでした</h1>
			<p>アドレスが間違っているか、ページが移動・削除された可能性があります。</p>
			<div class="links">
				<a href="/">トップへ</a>
				<a href="/blog/">記事一覧</a>
				<a href="/search/">記事を検索</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
