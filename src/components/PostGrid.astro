---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';

const { posts } = Astro.props;
---

<ul class="post-grid">
	{posts.map((post) => (
		<li class={`post-card${post.data.heroImage ? '' : ' no-image'}`}>
			<a href={`/blog/${post.id}/`}>
				{post.data.heroImage && (
					<div class="card-image-wrap">
						<Image src={post.data.heroImage} alt="" width={600} height={338} />
					</div>
				)}
				<div class="card-body">
					<div class="card-meta">
						<FormattedDate date={post.data.pubDate} />
						{post.data.category && <span class="card-category">{post.data.category}</span>}
					</div>
					<p class="card-title">{post.data.title}</p>
					<p class="card-desc">{post.data.description}</p>
				</div>
			</a>
		</li>
	))}
</ul>

<style>
	.post-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.8rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 12px;
		overflow: hidden;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}
	.post-card a {
		display: block;
		text-decoration: none;
		color: inherit;
		height: 100%;
	}
	.post-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-lg);
		border-color: var(--color-accent-soft);
	}
	.post-card.no-image {
		background: linear-gradient(135deg, #ffffff 0%, var(--color-bg-soft) 100%);
		border-left: 4px solid var(--color-accent);
	}
	.post-card.no-image .card-body {
		padding: 1.4rem 1.4rem 1.5rem;
	}
	.card-image-wrap {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--color-bg-soft);
	}
	.card-image-wrap :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		display: block;
		transition: transform 0.4s ease;
	}
	.post-card:hover .card-image-wrap :global(img) {
		transform: scale(1.05);
	}
	.card-body {
		padding: 1.2rem 1.4rem 1.5rem;
	}
	.card-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.78rem;
		color: var(--color-text-muted);
		margin-bottom: 0.6rem;
	}
	.card-category {
		color: var(--color-accent);
		font-weight: 600;
		background: rgba(182, 90, 59, 0.08);
		padding: 0.15rem 0.55rem;
		border-radius: 4px;
	}
	.card-title {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-primary);
		margin: 0 0 0.6rem;
		line-height: 1.5;
	}
	.card-desc {
		font-size: 0.88rem;
		color: var(--color-text-soft);
		line-height: 1.7;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	@media (max-width: 720px) {
		.post-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
		.card-image-wrap {
			aspect-ratio: 21 / 9;
		}
		.card-body {
			padding: 0.9rem 1.1rem 1.1rem;
		}
		.card-title {
			font-size: 0.98rem;
		}
		.card-desc {
			font-size: 0.83rem;
			-webkit-line-clamp: 2;
		}
	}
</style>
